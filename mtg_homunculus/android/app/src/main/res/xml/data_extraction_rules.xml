<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the same exclusion as backup_rules.xml, for both cloud
     backup and device-to-device transfer. The session is re-created by logging
     in again on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
